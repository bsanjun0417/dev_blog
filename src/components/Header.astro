---
/**
 * Header.astro
 * ──────────────────────────────────────────────────────────────────────────
 * 사이트 공통 헤더 컴포넌트.
 *
 * 구성 요소:
 *  - 브랜드 로고 (좌측)
 *  - 데스크톱 내비게이션 (중앙~우측)
 *  - 검색 토글 버튼
 *  - 모바일 햄버거 메뉴 (<details>)
 *  - 전체화면 검색 오버레이
 */
import {
  categoryLabels,
  getPostPath,
  getPublishedPosts,
  withBasePath,
} from "@lib/posts";

const navItems = [
  { path: "/docs", label: "Docs" },
  { path: "/posts", label: "Posts" },
  { path: "/about", label: "About" }
];

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentPath =
  Astro.url.pathname
    .replace(new RegExp(`^${basePath}`), "")
    .replace(/\/$/, "") || "/";

const searchPosts = await getPublishedPosts();
const searchIndex = searchPosts.map((post) => ({
  url: getPostPath(post),
  title: post.data.title,
  description: post.data.description,
  cover: post.data.cover ? withBasePath(post.data.cover) : "",
  category: categoryLabels[post.data.category],
  searchText: [
    post.data.title,
    post.data.description,
    ...post.data.tags,
  ].join(" ").toLocaleLowerCase("ko-KR"),
}));
const pagefindJs = withBasePath("pagefind/pagefind.js");

function isActive(href: string): boolean {
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="site-header">
  <a class="brand" href={withBasePath("/")}>
    <span class="brand-mark" aria-hidden="true">S</span>
    <span>san2blog</span>
  </a>

  <div class="header-actions">
    <nav class="desktop-nav" aria-label="주요 내비게이션">
      {navItems.map((item) => (
        <a
          href={withBasePath(item.path)}
          aria-current={isActive(item.path) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <button
      class="icon-button theme-toggle"
      type="button"
      aria-label="다크 모드로 변경"
      aria-pressed="false"
    >
      <svg class="theme-icon-sun" aria-hidden="true" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </svg>
      <svg class="theme-icon-moon" aria-hidden="true" viewBox="0 0 24 24">
        <path d="M20.5 14.8A8.5 8.5 0 0 1 9.2 3.5 8.5 8.5 0 1 0 20.5 14.8Z" />
      </svg>
    </button>

    <button
      class="icon-button search-toggle"
      type="button"
      aria-label="검색 열기"
      aria-expanded="false"
      aria-controls="site-search-overlay"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="m21 21-4.3-4.3" />
        <circle cx="11" cy="11" r="7" />
      </svg>
    </button>

    <details class="mobile-nav">
      <summary aria-label="메뉴 열기">Menu</summary>
      <nav aria-label="모바일 내비게이션">
        {navItems.map((item) => (
          <a
            href={withBasePath(item.path)}
            aria-current={isActive(item.path) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>

<div
  id="site-search-overlay"
  class="search-overlay"
  data-search-index={JSON.stringify(searchIndex)}
  data-pagefind-js={pagefindJs}
  hidden
>
  <div class="search-overlay-bar">
    <a class="search-overlay-brand" href={withBasePath("/")}>
      <span class="brand-mark" aria-hidden="true">S</span>
      <span>san2blog</span>
    </a>
    <button class="search-close" type="button" aria-label="검색 닫기">×</button>
  </div>

  <form class="overlay-search-form" action={withBasePath("/search")} method="get" role="search">
    <label class="sr-only" for="site-search-input">블로그 검색</label>
    <input
      id="site-search-input"
      name="q"
      type="search"
      placeholder="제목, 태그 검색"
      autocomplete="off"
    />
  </form>

  <div class="search-results-shell">
    <p class="search-status" role="status" aria-live="polite">
      검색어를 입력하세요.
    </p>
    <div class="search-results" aria-label="검색 결과"></div>
  </div>
</div>

<script>
  /**
   * 검색 오버레이 열기/닫기 제어.
   *  - 검색 버튼 클릭 → 열기 + 입력창 포커스
   *  - × 버튼 클릭 또는 Escape 키 → 닫기
   */
  const searchOverlay = document.querySelector("#site-search-overlay");
  const searchToggle  = document.querySelector(".search-toggle");
  const searchClose   = document.querySelector(".search-close");
  const searchInput   = document.querySelector("#site-search-input");
  const searchForm    = document.querySelector(".overlay-search-form");
  const searchStatus  = document.querySelector(".search-status");
  const searchResults = document.querySelector(".search-results");
  const themeToggle   = document.querySelector(".theme-toggle");
  type SearchPost = {
    url: string;
    title: string;
    description: string;
    cover: string;
    category: string;
    searchText: string;
  };
  const searchIndex = searchOverlay instanceof HTMLElement
    ? JSON.parse(searchOverlay.dataset.searchIndex ?? "[]") as SearchPost[]
    : [];
  const pagefindPath = searchOverlay instanceof HTMLElement
    ? searchOverlay.dataset.pagefindJs ?? ""
    : "";
  const normalizePath = (value: string) => {
    try {
      return decodeURI(new URL(value, window.location.origin).pathname).replace(/\/$/, "");
    } catch {
      return value.replace(/\/$/, "");
    }
  };
  const postsByPath = new Map(
    searchIndex.map((post) => [normalizePath(post.url), post]),
  );
  let pagefind: {
    search: (query: string) => Promise<{
      results: { data: () => Promise<{ url: string }> }[];
    }>;
  } | undefined;
  let pagefindUnavailable = false;
  let searchTimer: number | undefined;
  let searchVersion = 0;

  function renderSearchResults(posts: SearchPost[]) {
    if (!(searchResults instanceof HTMLElement)) return;
    searchResults.replaceChildren();

    posts.forEach((post) => {
      const link = document.createElement("a");
      const content = document.createElement("span");
      const title = document.createElement("strong");
      const description = document.createElement("span");
      const thumbnail = document.createElement("span");

      link.className = "search-result";
      link.href = post.url;
      content.className = "search-result-content";
      title.textContent = post.title;
      description.className = "search-result-description";
      description.textContent = post.description;
      thumbnail.className = "search-result-thumbnail";

      if (post.cover) {
        const image = document.createElement("img");
        image.src = post.cover;
        image.alt = "";
        image.loading = "lazy";
        thumbnail.append(image);
      } else {
        thumbnail.textContent = post.category;
      }

      content.append(title, description);
      link.append(content, thumbnail);
      searchResults.append(link);
    });
  }

  function fallbackSearch(query: string) {
    const tokens = query.toLocaleLowerCase("ko-KR").split(/\s+/).filter(Boolean);
    return searchIndex.filter((post) =>
      tokens.every((token) => post.searchText.includes(token)),
    );
  }

  async function searchPosts(query: string) {
    if (!pagefindUnavailable) {
      try {
        if (!pagefindPath) throw new Error("Pagefind path is missing");
        const engine = pagefind ??= await import(pagefindPath);
        const response = await engine.search(query);
        const results = await Promise.all(
          response.results.map(
            (result: { data: () => Promise<{ url: string }> }) => result.data(),
          ),
        );
        return results
          .map((result) => postsByPath.get(normalizePath(result.url)))
          .filter((post): post is SearchPost => post !== undefined);
      } catch {
        pagefindUnavailable = true;
      }
    }
    return fallbackSearch(query);
  }

  async function runSearch() {
    if (!(searchInput instanceof HTMLInputElement)) return;
    const query = searchInput.value.trim();
    const version = ++searchVersion;

    if (!query) {
      renderSearchResults([]);
      if (searchStatus) searchStatus.textContent = "검색어를 입력하세요.";
      return;
    }

    if (searchStatus) searchStatus.textContent = "검색 중…";
    const posts = await searchPosts(query);
    if (version !== searchVersion) return;

    renderSearchResults(posts);
    if (searchStatus) {
      searchStatus.textContent = posts.length
        ? `${posts.length}개의 글을 찾았습니다.`
        : "검색 결과가 없습니다.";
    }
  }

  function updateThemeToggle() {
    if (!(themeToggle instanceof HTMLButtonElement)) return;
    const isDark = document.documentElement.dataset.theme === "dark";
    themeToggle.setAttribute("aria-pressed", String(isDark));
    themeToggle.setAttribute("aria-label", isDark ? "라이트 모드로 변경" : "다크 모드로 변경");
  }

  function openSearchOverlay() {
    if (!(searchOverlay instanceof HTMLElement)) return;
    searchOverlay.hidden = false;
    document.body.classList.add("search-open");
    searchToggle?.setAttribute("aria-expanded", "true");
    // 약간의 딜레이 후 포커스 (CSS transition 안정화)
    window.setTimeout(() => {
      if (searchInput instanceof HTMLInputElement) searchInput.focus();
    }, 30);
  }

  function closeSearchOverlay() {
    if (!(searchOverlay instanceof HTMLElement)) return;
    searchOverlay.hidden = true;
    document.body.classList.remove("search-open");
    searchToggle?.setAttribute("aria-expanded", "false");
  }

  if (searchToggle instanceof HTMLButtonElement) {
    searchToggle.addEventListener("click", openSearchOverlay);
  }
  if (searchClose instanceof HTMLButtonElement) {
    searchClose.addEventListener("click", closeSearchOverlay);
  }
  if (searchInput instanceof HTMLInputElement) {
    searchInput.addEventListener("input", () => {
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(runSearch, 200);
    });
  }
  if (searchForm instanceof HTMLFormElement) {
    searchForm.addEventListener("submit", (event) => {
      event.preventDefault();
      window.clearTimeout(searchTimer);
      runSearch();
    });
  }
  if (themeToggle instanceof HTMLButtonElement) {
    updateThemeToggle();
    themeToggle.addEventListener("click", () => {
      const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = nextTheme;
      try { localStorage.setItem("theme", nextTheme); } catch {}
      updateThemeToggle();
    });
  }
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeSearchOverlay();
  });
</script>
