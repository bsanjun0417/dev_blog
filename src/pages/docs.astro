---
import Layout from "@layouts/Layout.astro";
import { withBasePath } from "@lib/posts";
import { docs } from "../data/docs";
---

<Layout title="문서" description="기술별 정리 문서 모음">
  <section class="docs-index-hero">
    <p class="section-label">Docs</p>
    <h1>기술 문서 모음</h1>
  </section>

  <section class="docs-index-grid" aria-label="문서 목록">
    {docs.map((doc) => (
      <a class="docs-index-card" href={withBasePath(`/docs/${doc.slug}`)}>
        <h2>{doc.title}</h2>
      </a>
    ))}
  </section>
</Layout>

<style>
  :global(main) {
    width: min(1120px, calc(100% - 32px));
  }

  .docs-index-hero {
    padding: 34px 0 14px;
  }

  .docs-index-hero h1 {
    max-width: 760px;
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.25;
    letter-spacing: 0;
  }

  .docs-index-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    padding: 10px 0 64px;
  }

  .docs-index-card {
    display: grid;
    align-content: center;
    min-height: 112px;
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    backdrop-filter: blur(22px) saturate(120%);
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .docs-index-card:hover {
    transform: translateY(-3px);
    border-color: rgba(17, 24, 39, 0.24);
    background: rgba(255, 255, 255, 0.74);
  }

  .docs-index-card h2 {
    margin: 0;
    font-size: 1.24rem;
    line-height: 1.18;
  }

  @media (max-width: 860px) {
    :global(main) {
      width: min(100% - 24px, 960px);
    }

    .docs-index-hero {
      padding-top: 26px;
    }

    .docs-index-grid {
      grid-template-columns: 1fr;
      padding-bottom: 56px;
    }

    .docs-index-card {
      min-height: auto;
    }
  }
</style>
