---
import Layout from "@layouts/Layout.astro";
import PostCard from "@components/PostCard.astro";
import categories from "../../../data/categories.json";
import { categoryLabels, getPublishedPosts, type Post } from "@lib/posts";

export function getStaticPaths() {
  const grouped = new Map<string, string[]>();
  categories.forEach(({ key, label }) => {
    const labels = grouped.get(key) ?? [];
    labels.push(label);
    grouped.set(key, labels);
  });
  return [...grouped].flatMap(([category, labels]) =>
    labels.slice(1).map((subcategory) => ({
      params: { category, subcategory }
    }))
  );
}

const category = Astro.params.category as Post["data"]["category"];
const subcategory = Astro.params.subcategory ?? "";
const posts = (await getPublishedPosts()).filter(
  (post) =>
    post.data.category === category &&
    post.data.subcategory === subcategory
);
---

<Layout
  title={`${subcategory} 글`}
  description={`${categoryLabels[category] ?? category} / ${subcategory} 글 목록`}
>
  <section class="page-hero section">
    <p class="section-label">Subcategory</p>
    <h1>{subcategory}</h1>
    <p>{posts.length}개의 글이 있습니다.</p>
  </section>
  <section class="section post-list">
    {posts.map((post) => <PostCard post={post} />)}
  </section>
</Layout>
