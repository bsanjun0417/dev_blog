---
/**
 * index.astro (Posts 목록 1페이지)
 * ──────────────────────────────────────────────────────────────────────────
 * /posts 경로에 대응하는 첫 번째 페이지.
 * 2페이지 이후는 posts/page/[page].astro 에서 처리한다.
 */
import Layout from "@layouts/Layout.astro";
import PostsArchive from "@components/PostsArchive.astro";
import {
  getCategoryTree,
  getPageCount,
  getPaginatedPosts,
  getPublishedPosts,
  getRecentTags
} from "@lib/posts";

const allPosts = await getPublishedPosts();
const currentPage = 1;
const pageCount = getPageCount(allPosts);
const posts = getPaginatedPosts(allPosts, currentPage);
const categories = getCategoryTree(allPosts);
const recentTags = getRecentTags(allPosts);
---

<Layout title="Posts" description="전체 글 목록">
  <PostsArchive
    posts={posts}
    categories={categories}
    recentTags={recentTags}
    currentPage={currentPage}
    pageCount={pageCount}
  />
</Layout>
